{
  "name": "lightingclient",
  "version": "1.0.2",
  "private": true,
  "description": "LightingClient Minecraft Java launcher",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/user": "^4.4.2",
    "electron-updater": "^6.8.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.lightingclient.launcher",
    "productName": "LightingClient",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gamerlwboy2314-code",
        "repo": "LightingClient",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**",
      "build/lightingclient.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/lightingclient.ico",
      "artifactName": "LightingClient-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
